# ---------------------------------------------------------------------------
# Composed Model Architecture
# ---------------------------------------------------------------------------

# Local grounding model (processes screenshots, never leaves your machine)
GROUNDING_MODEL=mlx/mlx-community/UI-TARS-1.5-7B-6bit

# Cloud planning model (receives sanitized text only, decides actions)
PLANNING_MODEL=openrouter/anthropic/claude-sonnet-4.5

# Override to use a single model instead of composed pipeline:
# CUA_MODEL=mlx/mlx-community/UI-TARS-1.5-7B-6bit

# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------

# OpenRouter API key (required for cloud planning model)
OPENROUTER_API_KEY=sk-or-...

# Anthropic API key (required by cua-agent internals)
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Cua Computer Server
# ---------------------------------------------------------------------------
CUA_COMPUTER_SERVER_HOST=localhost
CUA_COMPUTER_SERVER_PORT=5757

# ---------------------------------------------------------------------------
# PII Sanitization
# ---------------------------------------------------------------------------
# Set to false to disable PII masking before cloud calls
PII_SANITIZATION_ENABLED=true

# ---------------------------------------------------------------------------
# Memory & Observability
# ---------------------------------------------------------------------------
IMAGE_RETENTION_COUNT=1
TRAJECTORY_DIR=trajectories
TRAJECTORY_SCREENSHOT_DIR=trajectories/screenshots
