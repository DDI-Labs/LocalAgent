# ---------------------------------------------------------------------------
# Composed Model Architecture
# ---------------------------------------------------------------------------

# Local grounding model (processes screenshots, never leaves your machine)
GROUNDING_MODEL=mlx/mlx-community/UI-TARS-1.5-7B-6bit

# Cloud planning model (receives sanitized text only, decides actions)
PLANNING_MODEL=openrouter/anthropic/claude-sonnet-4.5

# Override to use a single model instead of composed pipeline:
# CUA_MODEL=mlx/mlx-community/UI-TARS-1.5-7B-6bit

# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------

# OpenRouter API key (required for cloud planning model)
OPENROUTER_API_KEY=sk-or-...

# Anthropic API key (required by cua-agent internals)
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Cua Computer Server (used when SANDBOX_ENABLED=false)
# ---------------------------------------------------------------------------
CUA_COMPUTER_SERVER_HOST=localhost
CUA_COMPUTER_SERVER_PORT=5757

# ---------------------------------------------------------------------------
# Sandbox (set SANDBOX_ENABLED=true to run in a VM instead of host machine)
# ---------------------------------------------------------------------------
SANDBOX_ENABLED=true

# Provider options: lume (local macOS VM), cloud (Cua cloud), docker (Linux container)
SANDBOX_PROVIDER=lume
SANDBOX_OS_TYPE=macos
SANDBOX_NAME=macos-sequoia-cua:latest

# Optional resource overrides
# SANDBOX_DISPLAY=1024x768
# SANDBOX_MEMORY=8GB
# SANDBOX_CPU=4

# Required for cloud provider only
# CUA_API_KEY=sk_cua-api01_...

# ---------------------------------------------------------------------------
# PII Sanitization
# ---------------------------------------------------------------------------
# Set to false to disable PII masking before cloud calls
PII_SANITIZATION_ENABLED=true

# ---------------------------------------------------------------------------
# Memory & Observability
# ---------------------------------------------------------------------------
IMAGE_RETENTION_COUNT=1
TRAJECTORY_DIR=trajectories
TRAJECTORY_SCREENSHOT_DIR=trajectories/screenshots

# ---------------------------------------------------------------------------
# Tracing (low-level click/type/screenshot logs with timing, saved as ZIPs)
# ---------------------------------------------------------------------------
# Set to true to save a trace ZIP per task alongside trajectories
TRACING_ENABLED=false
TRACING_DIR=traces

# ---------------------------------------------------------------------------
# Sandboxed Python & Interactive Shell
# ---------------------------------------------------------------------------
# Allow the planning model to run Python code / shell commands in the VM
# instead of clicking through UI (much faster for data/file tasks).
SANDBOXED_PYTHON_ENABLED=true
SANDBOXED_PYTHON_VENV=agent_env
INTERACTIVE_SHELL_ENABLED=true
# Timeout in seconds for a single shell command
SHELL_COMMAND_TIMEOUT=30

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Cua SDK anonymous usage stats (OS, run durations, token counts).
# Defaults to false (opted out). Set to true to allow collection.
CUA_TELEMETRY_ENABLED=false
